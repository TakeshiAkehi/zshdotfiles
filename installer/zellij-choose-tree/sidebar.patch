+                }
+            }
+            BareKey::Esc => self.new_session_name = None,
+            BareKey::Backspace => {
+                name.pop();
+            }
+            BareKey::Char(c) if c != '/' && key.key_modifiers.iter().all(|m| *m == KeyModifier::Shift) => name.push(c),
+            _ => {}
