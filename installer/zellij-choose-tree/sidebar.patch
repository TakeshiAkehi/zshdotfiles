diff --git a/src/utils.rs b/src/utils.rs
index 5ce6308..4d451cf 100644
--- a/src/utils.rs
+++ b/src/utils.rs
@@ -1,3 +1,39 @@
+use std::collections::BTreeMap;
+use std::sync::OnceLock;
+use zellij_tile::prelude::{close_self, hide_self, override_layout, LayoutInfo, LayoutMetadata};
+
+#[derive(Default)]
+struct ExitBehaviour {
+    close_on_exit: bool,
+    exit_layout: Option<String>,
+}
+
+static EXIT_BEHAVIOUR: OnceLock<ExitBehaviour> = OnceLock::new();
+
+pub fn set_exit_behaviour(close_on_exit: bool, exit_layout: Option<String>) {
+    let _ = EXIT_BEHAVIOUR.set(ExitBehaviour { close_on_exit, exit_layout });
+}
+
+// Leave the plugin pane according to `exit_layout` / `close_on_exit`:
+// - exit_layout: re-apply that layout to the tab (this plugin pane is dropped by it)
+// - close_on_exit: close the plugin pane
+// - otherwise: hide it (upstream behaviour)
+pub fn exit_self() {
+    let behaviour = EXIT_BEHAVIOUR.get_or_init(ExitBehaviour::default);
+    if let Some(layout) = &behaviour.exit_layout {
+        apply_layout(layout);
+    } else if behaviour.close_on_exit {
+        close_self();
+    } else {
+        hide_self();
+    }
+}
+
+// Re-apply a layout from the layout dir to the active tab, keeping its terminal panes
+pub fn apply_layout(layout: &str) {
+    override_layout(LayoutInfo::File(layout.to_string(), LayoutMetadata::default()), true, false, true, BTreeMap::new());
+}
+
 pub struct IdGenerator {
     id: usize,
 }
