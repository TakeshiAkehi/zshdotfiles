+use std::sync::OnceLock;
+use zellij_tile::prelude::{close_self, hide_floating_panes, hide_self};
+
+#[derive(Default)]
+struct ExitBehaviour {
+    close_on_exit: bool,
+    hide_floating_on_exit: bool,
+}
+
+static EXIT_BEHAVIOUR: OnceLock<ExitBehaviour> = OnceLock::new();
+
+pub fn set_exit_behaviour(close_on_exit: bool, hide_floating_on_exit: bool) {
+    let _ = EXIT_BEHAVIOUR.set(ExitBehaviour { close_on_exit, hide_floating_on_exit });
+}
+
+// Leave the plugin pane according to `close_on_exit`:
+// - close_on_exit: close the plugin pane (and hide the floating panes again if they were hidden
+//   before the sidebar was opened)
+// - otherwise: hide it (upstream behaviour)
+pub fn exit_self() {
+    let behaviour = EXIT_BEHAVIOUR.get_or_init(ExitBehaviour::default);
+    if behaviour.close_on_exit {
+        if behaviour.hide_floating_on_exit {
+            let _ = hide_floating_panes(None);
+        }
+        close_self();
+    } else {
+        hide_self();
+    }
+}
+
