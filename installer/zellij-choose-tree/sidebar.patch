@@ -0,0 +1,50 @@
+// Session switch history shared by all sessions through the plugin's /cache dir
+// (~/.cache/zellij/<plugin url>/plugin_cache): "<active session>\n<previous session>\n"
+use std::fs;
+use std::time::{Duration, Instant};
+
+const HISTORY_FILE: &str = "/cache/session_history";
+const CHECK_INTERVAL: Duration = Duration::from_secs(1);
+
+#[derive(Default)]
+pub struct SessionHistory {
+    last_check: Option<Instant>,
+}
+
+impl SessionHistory {
+    // Called on user input in `session`: make it the active one, the old active one becomes previous
+    pub fn mark_active(&mut self, session: &str) {
+        if self.last_check.is_some_and(|t| t.elapsed() < CHECK_INTERVAL) {
+            return;
+        }
+        self.last_check = Some(Instant::now());
+        let (active, _) = read();
+        if active.as_deref() == Some(session) {
+            return;
+        }
+        let previous = active.unwrap_or_default();
+        let _ = fs::write(HISTORY_FILE, format!("{}\n{}\n", session, previous));
+    }
+}
+
+// Keep the history pointing at a renamed session
+pub fn rename(old: &str, new: &str) {
+    let (active, previous) = read();
+    let rename = |name: Option<String>| name.map(|name| if name == old { new.to_string() } else { name });
+    let (active, previous) = (rename(active), rename(previous));
+    if let Some(active) = active {
+        let _ = fs::write(HISTORY_FILE, format!("{}\n{}\n", active, previous.unwrap_or_default()));
+    }
+}
+
+// The session to go back to from `current`
+pub fn last_session(current: &str) -> Option<String> {
+    let (active, previous) = read();
+    [active, previous].into_iter().flatten().find(|name| name != current)
+}
+
+fn read() -> (Option<String>, Option<String>) {
+    let content = fs::read_to_string(HISTORY_FILE).unwrap_or_default();
+    let mut lines = content.lines().map(str::trim).filter(|line| !line.is_empty()).map(String::from);
+    (lines.next(), lines.next())
+}
